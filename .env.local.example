# Shopify Storefront API
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# Email (Resend)
RESEND_API_KEY=re_your_key_here

# Site
NEXT_PUBLIC_SITE_URL=https://royalbacks.com

# Analytics (optional — used for map embeds on location pages)
NEXT_PUBLIC_GMB_PLACE_ID=your-google-maps-place-id

# --- Loyalty program (see docs/LOYALTY-SETUP.md) ---
# Unset = accounts render a "coming soon" page and webhooks reject everything.

# Shopify Admin API — needs read_all_orders, write_discounts, write_customers,
# write_draft_orders. Server-only, never NEXT_PUBLIC_.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2026-01
SHOPIFY_WEBHOOK_SECRET=

# Supabase. The service role key bypasses RLS — server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# openssl rand -base64 48   (must be at least 32 chars)
SESSION_SECRET=
# openssl rand -base64 32
CRON_SECRET=
